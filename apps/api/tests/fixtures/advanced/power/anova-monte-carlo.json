{
  "schemaVersion": "0.1.0",
  "analysisId": "power_monte_carlo_anova_001",
  "name": "Monte Carlo ANOVA power fixture",
  "confidenceLevel": 0.95,
  "seed": 20260720,
  "family": "power_analysis",
  "designFamily": "factorial_anova",
  "method": "monte_carlo",
  "solveFor": "power",
  "alpha": 0.05,
  "targetPower": 0.8,
  "sampleSize": 90,
  "effectSize": {"metric": "cohens_f", "value": 0.25},
  "groups": 3,
  "predictors": 1,
  "simulations": 1000,
  "alternative": "two_sided",
  "roundingRule": "ceil",
  "monteCarloParameters": {
    "dataGeneration": {"errorSd": 1.0},
    "estimandTarget": "omnibus",
    "convergenceFailureHandling": "drop"
  }
}
