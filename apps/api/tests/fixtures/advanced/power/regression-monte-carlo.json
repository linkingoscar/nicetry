{
  "schemaVersion": "0.1.0",
  "analysisId": "power_monte_carlo_regression_001",
  "name": "Monte Carlo regression power fixture",
  "confidenceLevel": 0.95,
  "seed": 20260720,
  "family": "power_analysis",
  "designFamily": "regression",
  "method": "monte_carlo",
  "solveFor": "power",
  "alpha": 0.05,
  "targetPower": 0.8,
  "sampleSize": 80,
  "effectSize": {"metric": "cohens_f2", "value": 0.15},
  "groups": 1,
  "predictors": 3,
  "simulations": 1000,
  "alternative": "two_sided",
  "roundingRule": "ceil",
  "monteCarloParameters": {
    "dataGeneration": {"errorSd": 1.0, "predictorCorrelation": 0.0},
    "estimandTarget": "overall",
    "convergenceFailureHandling": "drop"
  }
}
