{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchpath.local/schemas/reporting-profiles.schema.json",
  "title": "ResearchPath reporting disclosure profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "label", "scopeNote", "purpose", "requirements"],
      "properties": {
        "id": { "enum": ["apa_jars_quant", "strobe_observational", "consort_2025_randomized", "aea_data_code"] },
        "version": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "scopeNote": { "type": "string", "minLength": 1 },
        "purpose": { "const": "disclosure_completeness_only" },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "anyOfPaths"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "anyOfPaths": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^/" }
              },
              "requireNonNull": { "type": "boolean" },
              "expectedValue": {}
            }
          }
        }
      }
    }
  }
}
