{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchpath.local/schemas/advanced-analysis-spec.schema.json",
  "title": "ResearchPath AdvancedAnalysisSpec",
  "description": "实验设计、通用功效与精度、与下游分析模型绑定的多重插补和高级问卷测量的统一输入协议。",
  "oneOf": [
    { "$ref": "#/$defs/experimentalDesign" },
    { "$ref": "#/$defs/longitudinalModel" },
    { "$ref": "#/$defs/multilevelModel" },
    { "$ref": "#/$defs/multipleImputation" },
    { "$ref": "#/$defs/powerAnalysis" },
    { "$ref": "#/$defs/questionnaireMeasurement" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "common": {
      "type": "object",
      "required": ["analysisId", "name", "family"],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "analysisId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "family": {
          "enum": [
            "experimental_design",
            "longitudinal_model",
            "multilevel_model",
            "multiple_imputation",
            "power_analysis",
            "questionnaire_measurement"
          ]
        },
        "datasetVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "contextHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "sampleVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "sampleHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "structureVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "structureHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "measurementVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "measurementHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "datasetSha256": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "confidenceLevel": { "type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1 },
        "seed": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "estimandSpec": { "oneOf": [{ "$ref": "#/$defs/estimandSpec" }, { "type": "null" }] }
      }
    },
    "estimandSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisRole", "causalTarget", "identificationAssumptions", "effectScale"],
      "properties": {
        "analysisRole": {
          "enum": [
            "preregistered_primary",
            "preregistered_secondary",
            "planned_not_preregistered",
            "exploratory_post_data"
          ]
        },
        "causalTarget": { "type": "boolean" },
        "identificationAssumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "effectScale": {
          "enum": [
            "mean_difference",
            "standardized_difference",
            "odds_ratio",
            "indirect_effect",
            "within_person_slope",
            "regression_coefficient"
          ]
        }
      }
    },
    "betweenFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variableId", "coding"],
      "properties": {
        "variableId": { "$ref": "#/$defs/id" },
        "coding": { "enum": ["treatment", "sum", "helmert"] },
        "referenceLevel": { "type": ["string", "number", "null"] }
      }
    },
    "plannedContrast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "factorVariableId", "weights", "multiplicityFamilyId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "factorVariableId": { "$ref": "#/$defs/id" },
        "weights": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "number" }
        },
        "multiplicityFamilyId": { "$ref": "#/$defs/id" }
      }
    },
    "withinFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "levels", "columns"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "levels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "columns": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/id" }
        }
      }
    },
    "experimentalDesign": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [
            "datasetVersionId", "designType", "dataLayout", "outcomeIds",
            "betweenFactors", "withinFactors", "covariateIds", "sumOfSquares",
            "sphericityCorrection", "postHocAdjustment"
          ],
          "properties": {
            "family": { "const": "experimental_design" },
            "analysisType": { "enum": ["anova", "glm_cluster"] },
            "datasetVersionId": { "$ref": "#/$defs/id" },
            "designType": { "enum": ["factorial_anova", "ancova", "repeated_measures", "mixed_design"] },
            "dataLayout": { "enum": ["long", "wide"] },
            "outcomeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "betweenFactors": { "type": "array", "items": { "$ref": "#/$defs/betweenFactor" } },
            "withinFactors": { "type": "array", "items": { "$ref": "#/$defs/withinFactor" } },
            "subjectId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "covariateIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "sumOfSquares": { "enum": ["II", "III"] },
            "sphericityCorrection": { "enum": ["auto", "greenhouse_geisser", "huynh_feldt"] },
            "postHocAdjustment": { "enum": ["holm", "tukey", "games_howell", "benjamini_hochberg"] },
            "plannedContrasts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/plannedContrast" } },
            "covariateCentering": { "enum": ["grand_mean", "none"] },
            "homogeneityOfSlopes": { "enum": ["check_and_warn", "ignore"] }
            ,"clusterVariableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "clusterSe": { "const": "CR0" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "centeringRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variableId", "method"],
      "properties": {
        "variableId": { "$ref": "#/$defs/id" },
        "method": { "enum": ["none", "grand_mean", "group_mean"] }
      }
    },
    "randomEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupingVariableId", "intercept", "slopeVariableIds", "covariance"],
      "properties": {
        "groupingVariableId": { "$ref": "#/$defs/id" },
        "intercept": { "type": "boolean" },
        "slopeVariableIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "covariance": { "enum": ["correlated", "diagonal"] }
      }
    },
    "multilevelModel": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [
            "datasetVersionId", "analysisType", "distribution", "clusterVariableId",
            "centering", "estimator",
            "degreesOfFreedom", "minimumClusterCount"
          ],
          "properties": {
            "family": { "const": "multilevel_model" },
            "analysisType": { "enum": ["lmm", "aggregation"] },
            "datasetVersionId": { "$ref": "#/$defs/id" },
            "outcomeId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "distribution": { "enum": ["gaussian", "binomial", "poisson"] },
            "clusterVariableId": { "$ref": "#/$defs/id" },
            "higherLevelClusterVariableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "fixedEffectIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "randomEffects": { "type": "array", "items": { "$ref": "#/$defs/randomEffect" } },
            "centering": { "type": "array", "items": { "$ref": "#/$defs/centeringRule" } },
            "estimator": { "enum": ["REML", "ML", "MLR"] },
            "degreesOfFreedom": { "enum": ["satterthwaite", "kenward_roger", "asymptotic"] },
            "minimumClusterCount": { "type": "integer", "minimum": 10 },
            "scaleItemIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "scaleMin": { "type": "number" },
            "scaleMax": { "type": "number" },
            "aggregationMethod": { "enum": ["mean", "sum"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "longitudinalWave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "timeValue", "variables"],
      "properties": {
        "wave": { "type": "string", "minLength": 1, "maxLength": 40 },
        "timeValue": { "type": "number" },
        "variables": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/id" }
        }
      }
    },
    "longitudinalModel": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["datasetVersionId", "modelType", "subjectId", "waves", "estimator", "missing", "invarianceLevels"],
          "properties": {
            "family": { "const": "longitudinal_model" },
            "datasetVersionId": { "$ref": "#/$defs/id" },
            "modelType": { "enum": ["growth_curve", "cross_lagged_panel", "ri_clpm", "latent_growth", "longitudinal_invariance"] },
            "subjectId": { "$ref": "#/$defs/id" },
            "groupVariableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "timeVariableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "waves": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/longitudinalWave" } },
            "estimator": { "enum": ["ML", "MLR", "WLSMV"] },
            "missing": { "enum": ["fiml", "complete_cases"] },
            "invarianceLevels": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["configural", "metric", "scalar", "strict"] }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "imputationVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variableId", "method", "predictorIds"],
      "properties": {
        "variableId": { "$ref": "#/$defs/id" },
        "method": { "enum": ["auto", "pmm", "normal", "logistic", "multinomial_logistic", "ordinal_logistic", "cart", "two_level_normal", "two_level_binary"] },
        "predictorIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "passiveRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetVariableId", "expression"],
      "properties": {
        "targetVariableId": { "$ref": "#/$defs/id" },
        "expression": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "multipleImputation": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["datasetVersionId", "method", "imputations", "iterations", "variables", "passiveRules", "pooling", "diagnostics"],
          "properties": {
            "family": { "const": "multiple_imputation" },
            "datasetVersionId": { "$ref": "#/$defs/id" },
            "planVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "imputationPlanVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "contextHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
            "sampleVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "sampleHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
            "structureVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "structureHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
            "measurementVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "measurementHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
            "datasetSha256": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
            "predictorMatrixHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
            "method": { "enum": ["mice_fcs", "joint_model"] },
            "imputations": { "type": "integer", "minimum": 5, "maximum": 200 },
            "iterations": { "type": "integer", "minimum": 5, "maximum": 100 },
            "variables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/imputationVariable" } },
            "passiveRules": { "type": "array", "items": { "$ref": "#/$defs/passiveRule" } },
            "clusterVariableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "pooling": { "enum": ["none", "rubin"] },
            "pooledAnalysis": { "oneOf": [{ "$ref": "#/$defs/pooledAnalysis" }, { "type": "null" }] },
            "substantiveModelHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
            "diagnostics": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["trace", "distribution", "overimputation", "fraction_missing_information"] }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "effectSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value"],
      "properties": {
        "metric": { "enum": ["cohens_d", "cohens_f", "cohens_f2", "r_squared_change", "indirect_effect", "standardized_path", "odds_ratio", "intraclass_correlation"] },
        "value": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "pooledAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelType", "outcomeId", "predictorIds", "includeIntercept"],
      "properties": {
        "modelType": { "const": "linear_regression" },
        "outcomeId": { "$ref": "#/$defs/id" },
        "predictorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "includeIntercept": { "type": "boolean" }
      }
    },
    "powerAnalysis": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["designFamily"],
          "properties": {
            "family": { "const": "power_analysis" },
            "designFamily": { "enum": ["regression", "t_test", "mediation", "moderation", "factorial_anova", "repeated_measures", "multilevel", "sem"] },
            "method": { "enum": ["analytic", "monte_carlo"] },
            "solveFor": { "enum": ["sample_size", "power", "effect_size", "sensitivity", "ci_width"] },
            "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5 },
            "targetPower": { "type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1 },
            "sampleSize": { "type": ["integer", "null"], "minimum": 4 },
            "effectSize": { "oneOf": [{ "$ref": "#/$defs/effectSize" }, { "type": "null" }] },
            "effectSizeMetric": { "enum": ["cohens_d", "cohens_f", "cohens_f2", "r_squared_change", null] },
            "groups": { "type": "integer", "minimum": 1 },
            "predictors": { "type": "integer", "minimum": 1 },
            "targetCIWidth": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "sd": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "measurements": { "type": ["integer", "null"], "minimum": 2 },
            "clusters": { "type": ["integer", "null"], "minimum": 10 },
            "averageClusterSize": { "type": ["number", "null"], "exclusiveMinimum": 1 },
            "simulations": { "type": "integer", "minimum": 1000, "maximum": 100000 },
            "alternative": { "enum": ["two_sided", "one_sided"] },
            "allocationRatio": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "roundingRule": { "enum": ["ceil"] },
            "assumptions": { "type": "array", "items": { "type": "string" } },
            "monteCarloParameters": {
              "type": ["object", "null"],
              "additionalProperties": true
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "questionnaireMeasurement": {
      "type": "object",
      "required": ["analysisId", "name", "family", "modelType", "itemIds", "constructs"],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "analysisId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "datasetVersionId": { "$ref": "#/$defs/id" },
        "contextHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "sampleVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "sampleHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "structureVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "structureHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "measurementVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "measurementHash": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "datasetSha256": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "confidenceLevel": { "type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1 },
        "family": { "const": "questionnaire_measurement" },
        "itemIds": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "constructs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/measurementConstruct" } },
        "groupVariableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "modelType": {
          "enum": [
            "reliability",
            "efa",
            "cfa",
            "measurement_invariance",
            "esem_bifactor_irt",
            "bifactor",
            "esem",
            "irt",
            "common_method_bias",
            "marker_variable",
            "ulmc"
          ]
        },
        "markerVariableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "estimator": { "enum": ["ML", "MLR", "WLSMV", "MML"] },
        "itemScale": { "enum": ["continuous", "ordinal"] },
        "factorCount": { "type": "integer", "minimum": 1, "maximum": 20 },
        "rotation": { "enum": ["varimax", "promax", "target"] },
        "extractionMethod": { "enum": ["ml", "paf", "minres"] },
        "irtModel": { "enum": ["auto", "2PL", "GRM"] },
        "parallelIterations": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "invarianceLevels": { "type": "array", "uniqueItems": true, "items": { "enum": ["configural", "metric", "scalar", "strict"] } },
        "partialReleasedParameters": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "seed": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "additionalProperties": false
    },
    "measurementConstruct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "itemIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "itemIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "scoreId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    }
  }
}
