{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchpath.local/schemas/debt-register.schema.json",
  "title": "ResearchPath development debt register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "asOf", "statusVocabulary", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date" },
    "statusVocabulary": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/status" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/debtItem" }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "open",
        "in_progress",
        "implemented_pending_verification",
        "blocked",
        "accepted",
        "closed"
      ]
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "debtItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "priority",
        "title",
        "status",
        "ownerRole",
        "targetMilestone",
        "evidence",
        "acceptance",
        "closureEvidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "category": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "ownerRole": { "type": "string", "minLength": 1 },
        "targetMilestone": { "type": "string", "minLength": 1 },
        "acceptedUntil": { "type": "string", "format": "date" },
        "evidence": { "$ref": "#/$defs/nonEmptyStringArray" },
        "acceptance": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyStringArray" },
            { "minItems": 1 }
          ]
        },
        "closureEvidence": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "accepted" } } },
          "then": { "required": ["acceptedUntil"] }
        },
        {
          "if": { "properties": { "status": { "const": "closed" } } },
          "then": { "properties": { "closureEvidence": { "minItems": 1 } } }
        }
      ]
    }
  }
}
