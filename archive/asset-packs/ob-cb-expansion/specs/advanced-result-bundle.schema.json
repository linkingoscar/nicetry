{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchpath.local/schemas/advanced-result-bundle.schema.json",
  "title": "ResearchPath AdvancedResultBundle",
  "description": "高级方法实现完成后必须返回的最小结果封装；失败与取消不得生成 succeeded bundle。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "sampleFlow", "estimates", "diagnostics", "warnings", "provenance", "familyResult"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "analysisId", "family", "specHash", "durationMilliseconds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "const": "succeeded" },
        "analysisId": { "type": "string", "minLength": 1 },
        "family": { "enum": ["experimental_design", "multilevel_model", "longitudinal_model", "multiple_imputation", "power_analysis", "questionnaire_measurement"] },
        "specHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "sampleFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "included", "excluded", "missingMethod"],
      "properties": {
        "original": { "type": "integer", "minimum": 0 },
        "included": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "missingMethod": { "type": "string", "minLength": 1 },
        "clusters": { "type": "integer", "minimum": 0 },
        "waves": { "type": "integer", "minimum": 0 },
        "imputations": { "type": "integer", "minimum": 0 }
      }
    },
    "estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "estimate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "estimate": { "type": "number" },
          "standardError": { "type": ["number", "null"], "minimum": 0 },
          "statistic": { "type": ["number", "null"] },
          "degreesOfFreedom": { "type": ["number", "null"], "minimum": 0 },
          "pValue": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "confidenceLower": { "type": ["number", "null"] },
          "confidenceUpper": { "type": ["number", "null"] },
          "scale": { "type": "string" }
        }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "apaReports": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "plots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "format", "data"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "format": { "const": "svg" },
          "data": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engineVersion", "softwareVersions", "dataSha256", "seed", "specVersion", "family", "specHash"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "softwareVersions": { "type": "object", "additionalProperties": { "type": "string" } },
        "dataSha256": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "seed": { "type": "integer", "minimum": 1 },
        "specVersion": { "const": "0.1.0" },
        "estimand": { "type": "string" },
        "degreesOfFreedomMethod": { "type": "string" },
        "family": { "type": "string" },
        "specHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sliceId": { "type": "string" },
        "designType": { "type": "string" },
        "dataLayout": { "type": "string" },
        "postHocAdjustment": { "type": "string" },
        "postHocMethod": { "type": "string" },
        "plannedContrastCount": { "type": "integer", "minimum": 0 },
        "sumOfSquares": { "type": "string" },
        "distribution": { "type": "string" },
        "analysisType": { "type": "string" },
        "itemScale": { "type": "string" },
        "clusterVariableId": { "type": ["string", "null"] },
        "higherLevelClusterVariableId": { "type": ["string", "null"] },
        "estimator": { "type": "string" },
        "missingMethod": { "type": "string" },
        "centering": { "type": "array" },
        "scaleItemIds": { "type": "array", "items": { "type": "string" } },
        "scaleMin": { "type": "number" },
        "scaleMax": { "type": "number" },
        "aggregationMethod": { "type": "string" },
        "modelType": { "type": "string" },
        "groupVariableId": { "type": ["string", "null"] },
        "waveLabels": { "type": "array", "items": { "type": "string" } },
        "timeValues": { "type": "array", "items": { "type": "number" } },
        "wideToLong": { "type": "object" }
      }
    },
    "familyResult": {
      "oneOf": [
        { "$ref": "#/$defs/experimentalResult" },
        { "$ref": "#/$defs/glmClusterResult" },
        { "$ref": "#/$defs/multilevelResult" },
        { "$ref": "#/$defs/aggregationResult" },
        { "$ref": "#/$defs/longitudinalResult" },
        { "$ref": "#/$defs/imputationResult" },
        { "$ref": "#/$defs/powerResult" },
        { "$ref": "#/$defs/questionnaireMeasurementResult" }
      ]
    },
    "reportFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factId", "kind", "sourcePaths", "values"],
        "properties": {
          "factId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["estimate", "fit", "diagnostic", "warning", "sample_flow"] },
          "sourcePaths": { "type": "array", "items": { "type": "string" } },
          "values": { "type": "object" },
          "templates": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "experimentalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "omnibusTests", "estimatedMarginalMeans", "contrasts"],
      "properties": {
        "family": { "const": "experimental_design" },
        "omnibusTests": { "type": "array" },
        "estimatedMarginalMeans": { "type": "array" },
        "contrasts": { "type": "array" },
        "plannedContrasts": { "type": "array" },
        "sphericity": { "type": ["object", "null"] }
      }
    },
    "glmClusterResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "analysisType", "coefficients", "clusterVariableId", "clusterCount", "standardErrorMethod"],
      "properties": {
        "family": { "const": "experimental_design" },
        "analysisType": { "const": "glm_cluster" },
        "coefficients": { "type": "array" },
        "clusterVariableId": { "type": "string" },
        "clusterCount": { "type": "integer", "minimum": 2 },
        "standardErrorMethod": { "const": "CR0" }
      }
    },
    "multilevelResult": {
      "type": "object",
      "additionalProperties": false,
        "required": ["family", "fixedEffects", "randomEffects", "varianceComponents", "icc", "compiledFixedEffectIds"],
      "properties": {
        "family": { "const": "multilevel_model" },
        "fixedEffects": { "type": "array" },
        "randomEffects": { "type": "array" },
        "varianceComponents": { "type": "array" },
        "icc": { "type": "array" },
        "fitIndices": { "type": "object" },
        "compiledFixedEffectIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "aggregationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "analysisType", "aggregation"],
      "properties": {
        "family": { "const": "multilevel_model" },
        "analysisType": { "const": "aggregation" },
        "aggregation": { "type": "object" }
      }
    },
    "longitudinalResult": {
      "type": "object",
      "additionalProperties": false,
        "required": ["family", "modelType", "estimator", "missingMethod", "timeValues", "parameters", "waveSampleFlow", "fitIndices"],
      "properties": {
        "family": { "const": "longitudinal_model" },
        "modelType": { "type": "string" },
        "estimator": { "type": "string" },
        "missingMethod": { "type": "string" },
        "timeValues": { "type": "array", "items": { "type": "number" } },
        "parameters": { "type": "array" },
        "waveSampleFlow": { "type": "array" },
        "fitIndices": { "type": "object" },
        "invariance": { "type": ["object", "null"] },
        "missingPatterns": { "type": ["string", "null"] }
      }
    },
    "imputationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "imputations", "convergence", "missingInformation", "artifacts", "poolingStatus"],
      "properties": {
        "family": { "const": "multiple_imputation" },
        "imputations": { "type": "integer", "minimum": 1 },
        "convergence": { "type": "array" },
        "missingInformation": { "type": "array" },
        "artifacts": { "type": "array" },
        "poolingStatus": { "enum": ["not_available", "rubin"] },
        "pooledAnalysis": { "type": ["object", "null"] },
        "derivedDatasetSet": { "type": "object" },
        "trace": { "type": "array" },
        "distribution": { "type": "array" },
        "fractionMissingInformation": { "type": "array" }
      }
    },
    "powerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "solveFor", "solvedValue", "achievedPower", "parameters"],
      "properties": {
        "family": { "const": "power_analysis" },
        "solveFor": { "enum": ["sample_size", "power", "effect_size"] },
        "solvedValue": { "type": "number" },
        "achievedPower": { "type": "number", "minimum": 0, "maximum": 1 },
        "monteCarloStandardError": { "type": ["number", "null"], "minimum": 0 },
        "powerCurve": { "type": "array" },
        "method": { "enum": ["analytic", "monte_carlo"] },
        "simulationCount": { "type": "integer", "minimum": 1 },
        "validSimulations": { "type": "integer", "minimum": 1 },
        "failureCount": { "type": "integer", "minimum": 0 },
        "confidenceInterval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alpha", "alternative", "groups", "predictors", "effectSizeMetric", "solvedValueMetric"],
          "properties": {
            "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5 },
            "alternative": { "const": "two_sided" },
            "groups": { "type": "integer", "minimum": 1 },
            "predictors": { "type": "integer", "minimum": 1 },
            "effectSize": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["metric", "value"],
                  "properties": {
                    "metric": { "enum": ["cohens_d", "cohens_f", "cohens_f2", "r_squared_change"] },
                    "value": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                { "type": "null" }
              ]
            },
            "effectSizeMetric": { "enum": ["cohens_d", "cohens_f", "cohens_f2", "r_squared_change"] },
            "solvedValueMetric": { "enum": ["total_sample_size", "power", "cohens_d", "cohens_f", "cohens_f2", "r_squared_change"] },
            "allocationRatio": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "solvedEffectSize": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["metric", "value"],
                  "properties": {
                    "metric": { "enum": ["cohens_d", "cohens_f", "cohens_f2", "r_squared_change"] },
                    "value": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "questionnaireMeasurementResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "modelType", "sampleSize", "itemCount", "constructCount"],
      "properties": {
        "family": { "const": "questionnaire_measurement" },
        "modelType": { "type": "string" },
        "sampleSize": { "type": "integer", "minimum": 0 },
        "itemCount": { "type": "integer", "minimum": 0 },
        "constructCount": { "type": "integer", "minimum": 0 },
        "reliability": { "type": ["object", "null"] },
        "efa": { "type": ["object", "null"] },
        "cfa": { "type": ["object", "null"] },
        "invariance": { "type": ["object", "null"] },
        "bifactor": { "type": ["object", "null"] },
        "esem": { "type": ["object", "null"] },
        "irt": { "type": ["object", "null"] },
        "commonMethodBias": { "type": ["object", "null"] }
      }
    }
  }
}
