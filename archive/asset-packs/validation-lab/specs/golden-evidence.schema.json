{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://researchpath.org/schemas/golden-evidence.schema.json",
  "title": "GoldenEvidenceSchema",
  "description": "JSON Schema for ResearchPath AI-Agent Golden Standard Infrastructure Evidence and Manifests.",
  "type": "object",
  "definitions": {
    "EvidenceLevel": {
      "type": "string",
      "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"],
      "description": "G0: Production self-test, G1: Closed-form math, G2: Official open-source package, G3: Second independent implementation, G4: Commercial software output, G5: Parameter recovery simulation, G6: Metamorphic invariants, G7: Provenance and hashes."
    },
    "ComparatorKind": {
      "type": "string",
      "enum": [
        "exact",
        "absolute",
        "relative",
        "absolute_relative",
        "set_equivalent",
        "sign_indeterminate",
        "expected_failure"
      ]
    },
    "ComparisonRule": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "comparator": { "$ref": "#/definitions/ComparatorKind", "default": "absolute_relative" },
        "absTolerance": { "type": "number", "default": 1e-5 },
        "relTolerance": { "type": "number", "default": 1e-4 },
        "required": { "type": "boolean", "default": true }
      }
    },
    "DatasetEntry": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "rowCount": { "type": ["integer", "null"] },
        "columnCount": { "type": ["integer", "null"] }
      }
    },
    "ReferenceEngine": {
      "type": "object",
      "required": ["engine", "normalizedOutput"],
      "properties": {
        "engine": { "type": "string" },
        "version": { "type": "string", "default": "pinned" },
        "command": { "type": ["string", "null"] },
        "containerDigest": { "type": ["string", "null"] },
        "normalizedOutput": { "type": "string" }
      }
    },
    "CaseIdentity": {
      "type": "object",
      "required": ["goldenCaseId", "capabilityId"],
      "properties": {
        "goldenCaseId": { "type": "string" },
        "capabilityId": { "type": "string" },
        "caseVersion": { "type": "string", "default": "1.0.0" },
        "status": { "type": "string", "enum": ["draft", "frozen", "quarantined"], "default": "draft" }
      }
    },
    "CaseManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "identity",
        "dataset",
        "specPath",
        "primaryReference",
        "expectedOutputPath"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "default": 1 },
        "identity": { "$ref": "#/definitions/CaseIdentity" },
        "dataset": {
          "type": "array",
          "items": { "$ref": "#/definitions/DatasetEntry" }
        },
        "specPath": { "type": "string" },
        "estimandPath": { "type": ["string", "null"] },
        "primaryReference": { "$ref": "#/definitions/ReferenceEngine" },
        "secondaryReference": { "$ref": ["#/definitions/ReferenceEngine", "null"] },
        "comparisonRules": {
          "type": "array",
          "items": { "$ref": "#/definitions/ComparisonRule" }
        },
        "expectedOutputPath": { "type": "string" },
        "evidenceLevels": {
          "type": "array",
          "items": { "$ref": "#/definitions/EvidenceLevel" }
        }
      }
    },
    "CapabilityBundle": {
      "type": "object",
      "required": ["schemaVersion", "capabilityId", "methodFamily"],
      "properties": {
        "schemaVersion": { "type": "integer", "default": 1 },
        "capabilityId": { "type": "string" },
        "methodFamily": { "type": "string" },
        "cases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "type": "object",
  "required": ["schemaVersion", "identity", "dataset"],
  "allOf": [
    { "$ref": "#/definitions/CaseManifest" }
  ]
}
